{
  "name": "todo_app",
  "version": "2.0.0",
  "description": "Bun server serving the todo app React SPA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build src/server.ts --target=bun --production --outdir=dist",
    "start": "cd dist && NODE_ENV=production bun server.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
