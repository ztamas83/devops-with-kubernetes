{
  "name": "todo_backend",
  "version": "1.0.0",
  "description": "Bun server serving the todo REST API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build src/server.ts --target=bun --production --outdir=dist",
    "start": "NODE_ENV=production bun dist/server.js"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
